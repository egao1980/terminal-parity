(defpackage #:terminal-parity/generate
  (:use #:cl)
  (:local-nicknames (#:par #:terminal-parity))
  (:export #:generate))

(in-package #:terminal-parity/generate)

(defun generate (&key (backend (make-instance 'terminal-backend-ghostty:ghostty-backend)))
  "Replay corpus/inputs.sexp on the ghostty oracle and write
corpus/expected.sexp. Review the diff before committing it."
  (let ((fixtures (par:load-inputs)))
    (with-open-file (out (par:corpus-pathname "expected.sexp")
                         :direction :output :if-exists :supersede
                         :external-format :utf-8)
      (with-standard-io-syntax
        (let ((*package* (find-package '#:cl-user))
              (*print-pretty* t)
              (*print-right-margin* 100)
              (*print-readably* nil))
          (format out ";;;; GENERATED by (terminal-parity/generate:generate) from inputs.sexp~%")
          (format out ";;;; Oracle: libghostty-vt ~A. Do not edit; edit inputs.sexp and regenerate.~%~%"
                  (ghostty-vt:ghostty-vt-version))
          (dolist (fixture fixtures)
            (let ((whole (par:run-fixture fixture backend))
                  (split (par:run-fixture fixture backend :split t)))
              (unless (equal whole split)
                (warn "~A: oracle differs when fed byte by byte" (par:fixture-name fixture)))
              (prin1 (append fixture whole) out)
              (terpri out) (terpri out))))))
    (write-palette backend)
    (length fixtures)))

(defun write-palette (backend)
  "corpus/palette.sexp: the oracle's default foreground, background and
256-colour palette, as (r g b) lists."
  (terminal-protocol:with-terminal (terminal :backend backend)
    (terminal-protocol:with-frame (frame terminal)
      (let ((colors (terminal-protocol:frame-colors frame)))
        (flet ((rgb (c) (list (terminal-protocol:rgb-r c) (terminal-protocol:rgb-g c)
                              (terminal-protocol:rgb-b c))))
          (with-open-file (out (par:corpus-pathname "palette.sexp")
                               :direction :output :if-exists :supersede)
            (with-standard-io-syntax
              (let ((*package* (find-package '#:cl-user)) (*print-right-margin* 100)
                    (*print-pretty* t))
                (format out ";;;; GENERATED with expected.sexp: the oracle's default colours.~%")
                (prin1 (list :foreground (rgb (terminal-protocol:terminal-colors-foreground colors))
                             :background (rgb (terminal-protocol:terminal-colors-background colors))
                             :palette (map 'list #'rgb
                                           (terminal-protocol:terminal-colors-palette colors)))
                       out)
                (terpri out)))))))))
